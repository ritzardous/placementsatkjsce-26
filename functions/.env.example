# Copy to .env.YOUR_PROJECT_ID (ignored by Git). Empty values disable email;
# the admin queue and notification badge still work.
PROCEDURE_ADMIN_EMAILS=
PROCEDURE_EMAIL_FROM=
PROCEDURE_APP_URL=
# Set the API key with firebase functions:secrets:set PROCEDURE_RESEND_API_KEY.
# Do not put secrets in this file or in any VITE_ variable.
